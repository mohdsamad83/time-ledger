# ── Google Sheets Integration ─────────────────────────────────────────────────
# Create a Service Account in Google Cloud Console, enable the Sheets API,
# and share your spreadsheet with the service account email.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The private key from your service account JSON (keep the -----BEGIN/END lines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID from your Google Spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Optional: public URL shown as a link in the nav bar
NEXT_PUBLIC_SHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id_here/edit
